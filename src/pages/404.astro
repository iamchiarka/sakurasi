---
import Layout from '../layouts/Layout.astro';
import MoonHeading from '../components/MoonHeading.astro';
---

<Layout title="Not found · SAKURASI">
	<MoonHeading>
		<h1 class="tracking-[0.04em]">Not found</h1>
	</MoonHeading>
	<p class="verse mt-10">
		this path has no bloom<br />
		the wind carried it elsewhere<br />
		<a href="/" class="text-ink underline decoration-accent underline-offset-[6px] transition-[color] duration-150 hover:text-accent">return to the tree</a>
	</p>
</Layout>
