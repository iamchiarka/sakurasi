---
import Layout from '../layouts/Layout.astro';
import MoonHeading from '../components/MoonHeading.astro';
---

<Layout title="SAKURASI · さくラシ">
	<MoonHeading class="text-[clamp(2.25rem,min(11.5vw,13vh),6rem)]">
		<h1 class="headline tracking-[0.06em] uppercase">Sakurasi</h1>
		<p lang="ja" class="mt-4 text-[clamp(1.125rem,0.3em,1.5rem)] tracking-[0.2em] text-ink-soft">
			さく<span class="text-accent">ラシ</span>
		</p>
	</MoonHeading>

	<figure class="relative mt-14 w-fit [@media(max-height:700px)]:mt-8">
		<span lang="ja" class="pointer-events-none absolute top-20 -right-10 -z-10 text-[10rem] leading-none text-watermark select-none sm:-top-20 sm:right-auto sm:left-[62%] sm:text-[17rem]" aria-hidden="true">桜</span>
		<blockquote class="verse">
			petals on the wind<br />
			a small page waits for its words<br />
			nothing is missing
		</blockquote>
		<figcaption class="mt-5 text-sm tracking-[0.1em] text-muted">— Raphael</figcaption>
	</figure>
</Layout>

<style>
	.headline {
		text-shadow: 0.03em -0.03em 0.3em var(--rim);
	}
</style>
