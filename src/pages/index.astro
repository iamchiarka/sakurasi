---
import Layout from '../layouts/Layout.astro';
---

<Layout title="home">
	<div>
		<span class="inline-flex items-center gap-2 rounded-full bg-rose-600/10 px-3 py-1 text-xs text-rose-800 dark:bg-rose-400/10 dark:text-rose-200">
			<span class="size-1.5 animate-pulse rounded-full bg-rose-500 dark:bg-rose-400"></span>
			in bloom · new pages growing slowly
		</span>
	</div>
	<p class="mt-6 text-xs tracking-[0.35em] text-rose-600 dark:text-rose-400">RAPHAEL</p>
	<h1 class="mt-1 font-serif text-5xl font-bold tracking-wide sm:text-8xl sm:tracking-wider">SAKURASI</h1>
	<p lang="ja" class="mt-2 font-serif text-xl tracking-[0.4em] text-rose-700 sm:text-2xl dark:text-rose-300">さくラシ</p>
	<div class="my-6 h-0.5 w-14 bg-rose-500 dark:bg-rose-400"></div>
	<p class="font-serif text-base leading-loose text-stone-500 dark:text-stone-400">
		petals on the wind<br />
		a small page waits for its words<br />
		nothing is missing
	</p>
</Layout>
